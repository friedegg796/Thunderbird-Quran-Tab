{
  "manifest_version": 2,
  "name": "Quran Tab",
  "description": "Thunderbird extension to open quran.com in a new tab.",
  "version": "1.0.0",
  "author": "Hasnain Alahi (friedegg796)",
  "homepage_url": "https://github.com/friedegg796/Thunderbird-Quran-Tab",
  "browser_specific_settings": {
    "gecko": {
      "id": "friedegg796.quran_tab@addons.thunderbird.net",
      "strict_min_version": "106.0"
    }
  },  
    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "https://*.quran.com/*"
    ],
  "icons": {
    "32": "quran_tab_icon.svg",
    "48": "quran_tab_icon.svg",
    "96": "quran_tab_icon.svg"
  },
  "background": {
    "scripts": [
      "qurantab.js"
    ]
  }
}